[TEMPLATE]
# PS-14 — Environment template
# Copy to .env and generate secrets before any non-local deployment.
DB_DIR=db

# =============================================================================
# SECURITY: Generate random secrets before any non-local deployment
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))" for each
# =============================================================================

# JWT signing key (HS256) - used for user session tokens
JWT_SECRET=<generate-with-python-secrets>
JWT_EXPIRY_MINUTES=15

# PII encryption key (AES-256) - SEPARATE from JWT for defense in depth
# Used to encrypt email, phone, and other PII in DB-1
PII_ENCRYPTION_KEY=<generate-with-python-secrets>

# Export signing key (HMAC-SHA256) - SEPARATE from JWT for compliance
# Used to sign audit exports so regulators can verify integrity
EXPORT_SIGNING_KEY=<generate-with-python-secrets>

# Shared secret for service-to-service calls (mTLS in production, section 4).
INTERNAL_TOKEN=<generate-with-python-secrets>

# Compliance-role gate for the audit viewer in the verification UI.
COMPLIANCE_TOKEN=<generate-with-python-secrets>

# Front-page ADMIN area: bootstrap passphrase (used ONCE to create the admin
# record; afterwards only the stored scrypt hash is verified).
ADMIN_USER=admin
ADMIN_PASS=<generate-with-python-secrets>

# =============================================================================
# SECURITY: CORS origins - restrict to your actual domains in production
# Comma-separated list of allowed origins (NO wildcards in production!)
# =============================================================================
CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8004,http://localhost:8000,http://localhost:8004

# Service URLs for server-to-server chaining.
AUDIT_URL=http://127.0.0.1:8005

# =============================================================================
# PRODUCTION MODE
# Set to "production" to enable fail-closed startup validation.
# In production mode, missing or default secrets cause the service to abort.
# =============================================================================
PS14_MODE=development

# =============================================================================
# PRODUCTION: Domain (for Caddy reverse proxy with auto-HTTPS)
# Required for docker-compose.prod.yml
# =============================================================================
# DOMAIN=ps14.example.com

# =============================================================================
# PRODUCTION: PostgreSQL
# When DATABASE_URL is set, all services use PostgreSQL instead of SQLite.
# Tables are auto-created on startup with per-service schema isolation.
# Run: python scripts/migrate_to_postgres.py (for initial schema setup)
# Schema DDL is maintained in scripts/supabase_migration_v2.sql (run against
# the target Postgres/Supabase DB once, then set DATABASE_URL).
# Run: python scripts/sqlite_to_postgres.py (to migrate existing data)
# =============================================================================
# DATABASE_URL=postgresql://ps14:YOUR-PASSWORD@localhost:5432/ps14

# PostgreSQL credentials (used by docker-compose.prod.yml)
POSTGRES_USER=ps14
POSTGRES_PASSWORD=<generate-with-python-secrets>

# Per-service schema isolation (set in docker-compose.prod.yml automatically)
# DB_SCHEMA=identity  # or privacy, risk, audit, verification
# SERVICE_NAME=IDENTITY  # or PRIVACY, RISK, AUDIT, VERIFY

# =============================================================================
# PRODUCTION: Supabase (optional - uses pooled connections)
# When using Supabase, set DATABASE_URL to the pooler connection string.
# =============================================================================
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=<from Supabase Dashboard -> Settings -> API>
# SUPABASE_ANON_KEY=<from Supabase Dashboard -> Settings -> API>

# =============================================================================
# SECURITY NOTES:
# 1. NEVER commit .env to version control
# 2. Rotate secrets periodically (quarterly recommended)
# 3. Use a secrets manager in production (HashiCorp Vault, AWS Secrets Manager)
# 4. Each key serves a different purpose - do not reuse across services
# 5. JWT_SECRET also derives fernet_key and export_signing_key — coordinate
#    rotations carefully (existing DB-1 PII becomes unreadable on change)
# =============================================================================
