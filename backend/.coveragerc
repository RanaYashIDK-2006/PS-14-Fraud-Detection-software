# Phase 13 — canonical coverage.py config for backend/src.
# Paths in this file are resolved relative to the WORKING DIRECTORY, which is
# the backend/ directory (backend/scripts/coverage_run.py always runs there).
# Do not run `coverage` from the repo root with this file: `source = src`
# would then resolve to a non-existent ./src and fail visibly (that failure is
# intentional — see docs/evaluation/PHASE_TEST_COVERAGE_CLOSEOUT.md).
[run]
branch = True
source = src

[report]
show_missing = True
precision = 1
skip_covered = false
