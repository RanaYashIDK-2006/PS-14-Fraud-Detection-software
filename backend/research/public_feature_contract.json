  "missing_from_public": {
    "count": 7,
    "features": [
      "new_device_flag (requires device_id)",
      "unusual_location_flag (requires geolocation baseline)",
      "unusual_recipient_flag (requires recipient history)",
      "shared_device_accounts (requires device-account graph)",
      "shared_recipient_accounts (requires recipient-account graph)",
      "mule_ring_score (requires full account graph)",
      "recipient_novelty (requires recipient history)"
    ],
    "note": "These require institutional-grade device/location/recipient telemetry"
  }
